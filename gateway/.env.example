# ── Passerelle IA Elytras — configuration (NE PAS committer le .env réel) ──

# Clé du backend modèles = OpenRouter (une facture, tous les modèles). Reste côté serveur.
OPENROUTER_API_KEY=

# Jeton admin de la passerelle (gestion des clients / lecture de l'usage).
# Génère : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
GATEWAY_ADMIN_TOKEN=

# Marge refacturée au client (1.0 = au coût, 1.5 = +50 %, 2.0 = ×2).
GW_MARKUP=1.5

# Gammes -> modèle réel (ids OpenRouter) + prix $/1M tokens (entrée/sortie).
# Ajuste les ids et les prix aux tarifs réels du moment.
GW_ECO_MODEL=deepseek/deepseek-chat
GW_ECO_IN=0.14
GW_ECO_OUT=0.28
GW_STD_MODEL=openai/gpt-5-mini
GW_STD_IN=0.25
GW_STD_OUT=2.00
GW_MAX_MODEL=anthropic/claude-haiku-4.5
GW_MAX_IN=1.00
GW_MAX_OUT=5.00
GW_DEFAULT_TIER=eco

# Persistance (mode fichier).
GATEWAY_STATE_FILE=.gateway-state.json
