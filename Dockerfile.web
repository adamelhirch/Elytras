# Dockerfile.web — Build Next.js (apps/web) en mode standalone
# Compatible avec le monorepo pnpm (workspace @elytras/db)
#
# Usage :
#   docker build -f Dockerfile.web -t elytras-web .
#
# Multi-stage :
#   1. deps     — installe les dépendances pnpm (cache layer)
#   2. builder  — build Next.js standalone
#   3. runner   — image de prod légère

FROM node:22-bookworm-slim AS base

RUN corepack enable && corepack prepare pnpm@latest --activate

# ─── Stage 1 : installation des dépendances ───────────────────────────────────
FROM base AS deps

WORKDIR /repo

# Fichiers de config workspace (racine → packages → app)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/db/package.json ./packages/db/package.json
COPY apps/web/package.json ./apps/web/package.json

# Installe les deps pour le build web + db (inclut devDeps pour tsx/drizzle-kit)
RUN pnpm install --frozen-lockfile --filter "@elytras/db..." --filter "web..."

# ─── Stage 2 : build ──────────────────────────────────────────────────────────
FROM base AS builder

WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /repo/apps/web/node_modules ./apps/web/node_modules

# Sources
COPY packages/db ./packages/db
COPY apps/web ./apps/web
COPY pnpm-workspace.yaml .npmrc ./

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js standalone
RUN pnpm --filter web build

# ─── Stage 3 : image de production ───────────────────────────────────────────
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copier le standalone Next.js (inclut server.js + toutes les deps minimales)
COPY --from=builder /repo/apps/web/.next/standalone ./
COPY --from=builder /repo/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000

# Le serveur standalone est à apps/web/server.js dans l'arbo du monorepo
CMD ["node", "apps/web/server.js"]
