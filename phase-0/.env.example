# ---- Base de données ----
POSTGRES_USER=elytras
POSTGRES_PASSWORD=elytras
POSTGRES_DB=elytras

# ---- Provider LLM par défaut ----
# codex | claude | gemini | openai | ollama
ELYTRAS_PROVIDER=codex
ELYTRAS_MODEL=gpt-5

# Les providers d'ABONNEMENT (Codex / Claude / Gemini) se connectent depuis l'INTERFACE
# (carte Providers -> « Se connecter »). L'OAuth est géré nativement par Elytras (login +
# PKCE + refresh) ; rien à mettre ici. ⚠️ Usage perso/self-host (voir Phase-0.md, ToS).

# Provider par clé API classique (optionnel, pour ELYTRAS_PROVIDER=openai)
OPENAI_API_KEY=
# En-tête beta pour l'inférence Claude par OAuth (optionnel)
ANTHROPIC_BETA=oauth-2025-04-20

# Connexion Gemini (Google) par OAuth : identifiants « desktop » du CLI Google.
# Publics mais NON inclus dans le code source — renseigne-les ici pour activer Gemini.
# Sans ces valeurs, le bouton « Se connecter » Gemini est simplement désactivé.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# ---- Ollama natif sur le Mac (embeddings mémoire + petits modèles locaux) ----
OLLAMA_HOST=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text

# ---- Sécurité / OAuth ----
# Chiffre TOUS les secrets (tokens providers + serveurs MCP, clés API).
# LAISSE VIDE en local : Elytras génère une clé forte au 1er lancement et la
# PERSISTE (fichier .elytras-key, chmod 600, jamais committé).
# Pour fixer ta propre clé : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENCRYPTION_KEY=
# URL publique du cœur (redirect OAuth des serveurs MCP). En local :
PUBLIC_BASE_URL=http://localhost:8000

# Note : les connecteurs (Shopify, Odoo, Gmail…) ne se configurent PAS ici.
# Ce sont des serveurs MCP enregistrés depuis l'interface (avec OAuth si besoin).
